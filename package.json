{
  "name": "at-field",
  "version": "0.1.1",
  "description": "Text-in, theme-crossed lexical field analysis out.",
  "keywords": [
    "transcript",
    "lexical-field",
    "theme",
    "srt",
    "vtt",
    "text-analysis",
    "ollama",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promethee/at-field.git"
  },
  "bugs": {
    "url": "https://github.com/promethee/at-field/issues"
  },
  "homepage": "https://promethee.github.io/at-field/",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "at-field": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage src/*.test.ts",
    "test:watch": "node --import tsx --test --watch src/*.test.ts",
    "check:pack": "node scripts/check-pack.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run check:pack",
    "check:model": "node --import tsx scripts/check-default-model.mjs"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "franc-min": "^6.2.0",
    "iso-639-3": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
